{
  "manifest_version": 3,
  "name": "Changelogger",
  "description": "Track changelogs across products and keep a personal todo list on every new tab.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Changelogger",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*/*", "http://*/*"]
}
